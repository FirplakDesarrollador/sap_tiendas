# Supabase Cloud Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SAP Business One Service Layer Configuration
SAP_BASE_URL=https://your-sap-server:50000/b1s/v1
SAP_COMPANY_DB=Firplak_SA
SAP_USERNAME=manager
SAP_PASSWORD="your-sap-password"

# Escrituras a SAP (opcional). Sin SAP_WRITES_ENABLED=1 todo POST/PATCH/DELETE/acción es simulación (dry-run).
# SAP_WRITES_ENABLED=1
# Fuerza simulación aunque SAP_WRITES_ENABLED=1 (útil en desarrollo).
# SAP_DRY_RUN=1
